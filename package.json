{
  "name": "claude-animation-base",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Clawd, painted in p5.brush: a character kit and guide for making hand-painted Clawd animations with Remotion support",
  "scripts": {
    "dev": "remotion preview",
    "preview": "remotion preview",
    "build": "remotion render",
    "voice": "python scripts/generate_voice.py",
    "voice:eleven": "python scripts/generate_voice.py --engine elevenlabs",
    "sheet": "node render.mjs --sheet=0,1,2,3,4,5 --out=out/sheet.jpg",
    "video": "node render.mjs --clip --out=out/video.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.541",
    "@remotion/media-utils": "^4.0.541",
    "@remotion/player": "^4.0.541",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "p5": "^2.3.3",
    "p5.brush": "^2.2.3",
    "puppeteer-core": "^25.11.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541",
    "typescript": "^7.0.2"
  }
}
